# ════════════════════════════════════════════════════════════════
# STOCKEYE BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════

# ─── Flask Configuration ────────────────────────────────────────
# Generate a strong key: python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=change-this-to-random-secret-in-production
FLASK_ENV=development

# ─── AI Provider API Keys ───────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── News & Sentiment APIs ──────────────────────────────────────
NEWS_API_KEY=your-newsapi-org-key
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=StockAssistant/1.0

# ─── Database Configuration ─────────────────────────────────────
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_PATH=./database/stock_assistant.db

# ─── Supabase Auth (server-side) ────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ─── CORS ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
