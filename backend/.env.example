# ════════════════════════════════════════════════════════════════
# STOCKEYE BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════

# ─── Flask Configuration ────────────────────────────────────────
# Generate a strong key: python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=change-this-to-random-secret-in-production
FLASK_ENV=development

# ─── AI Provider (model-agnostic via llm_client) ────────────────
# Which provider the whole app uses. Default: gemini.
LLM_PROVIDER=gemini
# Gemini (default). A Vertex AI *Express* key works with GEMINI_USE_VERTEX=true.
# Set GEMINI_USE_VERTEX=false if using a plain Gemini Developer API key.
GEMINI_API_KEY=your-gemini-or-vertex-express-key
GEMINI_USE_VERTEX=true
# Optional per-provider model overrides (sensible defaults are built in):
# GEMINI_MODEL_FAST=gemini-2.5-flash
# GEMINI_MODEL_DEEP=gemini-2.5-pro
# Optional fallbacks — only needed if you switch LLM_PROVIDER to these:
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── News & Sentiment APIs ──────────────────────────────────────
NEWS_API_KEY=your-newsapi-org-key
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=StockAssistant/1.0

# ─── Database Configuration ─────────────────────────────────────
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_PATH=./database/stock_assistant.db

# ─── Supabase Auth (server-side) ────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ─── CORS ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Live Broker (Zerodha Kite) — optional ──────────────────────
# Live trading is approval-gated + kill-switched (default OFF).
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Encryption key for broker access tokens at rest. REQUIRED in production
# (FLASK_ENV=production) — the app refuses the insecure dev fallback there.
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'
BROKER_TOKEN_KEY=
