# ════════════════════════════════════════════════════════════════
# STOCK ASSISTANT - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your API keys
# ════════════════════════════════════════════════════════════════

# ─── Flask Configuration ────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-random-secret-in-production
FLASK_ENV=development

# ─── AI Provider API Keys ───────────────────────────────────────
# OpenAI GPT-4 - Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude - Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── News & Sentiment APIs ──────────────────────────────────────
# NewsAPI - Get key from: https://newsapi.org/
NEWS_API_KEY=your-newsapi-org-key

# Reddit API (optional) - Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=StockAssistant/1.0

# ─── Database Configuration ─────────────────────────────────────
DATABASE_PATH=./database/portfolio.db

# ─── Frontend Configuration ─────────────────────────────────────
# Frontend URL for CORS (change in production)
FRONTEND_URL=http://localhost:3000

# ─── Production Settings ────────────────────────────────────────
# Set to 'production' when deploying
# FLASK_ENV=production

# ════════════════════════════════════════════════════════════════
# NOTES:
# - Never commit the .env file to git (it's in .gitignore)
# - In production, use strong random secrets
# - For dual AI: Set both OPENAI_API_KEY and ANTHROPIC_API_KEY
# - Auto mode will route queries intelligently between providers
# ════════════════════════════════════════════════════════════════
